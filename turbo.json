{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "i18n:check": {
      "dependsOn": ["^i18n:check"],
      "inputs": ["src/i18n/**"],
      "outputs": []
    },
    "clean:build": {
      "dependsOn": ["^clean:build"],
      "cache": false
    }
  }
}
