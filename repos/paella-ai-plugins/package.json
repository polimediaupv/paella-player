{
  "name": "@asicupv/paella-ai-plugins",
  "version": "3.0.0-beta.4",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/paella-ai-plugins.es.d.ts",
      "import": "./dist/paella-ai-plugins.es.js"
    },
    "./paella-ai-plugins.css": {
      "import": "./dist/paella-ai-plugins.css"
    }
  },
  "description": "Plugins for Paella Player that provides AI functionality.",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsc && vite build --watch --mode development --emptyOutDir false",
    "i18n:check": "i18n-check -s en-US -l ./src/i18n",
    "build": "tsc && vite build --emptyOutDir",
    "test": "node tests/chatwebllm.test.ts && node tests/embeddings.test.ts",
    "clean:build": "rimraf .turbo dist",
    "clean:deps": "rimraf node_modules"
  },
  "main": "./dist/paella-ai-plugins.es.js",
  "files": [
    "dist/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polimediaupv/paella-player.git"
  },
  "keywords": [
    "paella",
    "player",
    "AI"
  ],
  "author": "Miguel Escriva Gregori <miesge@gmail.com>",
  "license": "SEE LICENSE IN license.txt",
  "bugs": {
    "url": "https://github.com/polimediaupv/paella-player/issues"
  },
  "homepage": "https://github.com/polimediaupv/paella-player#readme",
  "devDependencies": {
    "@asicupv/paella-core": "^3.0.0-beta.5",
    "@preact/preset-vite": "^2.10.5",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^5.1.2"
  },
  "dependencies": {
    "@langchain/classic": "^1.0.36",
    "@huggingface/transformers": "^4.3.2",
    "@langchain/core": "^1.1.42",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.4.5",
    "@mlc-ai/web-llm": "^0.2.82",
    "dompurify": "^3.4.15",
    "langchain": "^1.5.4",
    "marked": "^18.0.7",
    "preact": "^10.29.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@asicupv/paella-core": "^3.0.0-beta.5"
  }
}
